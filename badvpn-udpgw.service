[Unit]
Description=BadVPN UDPGW (Rust High-Performance Rewrite)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/badvpn-udpgw --listen-addr 127.0.0.1:7300 --max-clients 1000 --max-connections-for-client 10 --loglevel notice
Restart=always
RestartSec=2
LimitNOFILE=65536
Nice=-5

[Install]
WantedBy=multi-user.target
